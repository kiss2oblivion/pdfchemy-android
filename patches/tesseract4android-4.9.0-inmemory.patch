diff --git a/tesseract4android/src/main/cpp/tesseract/tessbaseapi.cpp b/tesseract4android/src/main/cpp/tesseract/tessbaseapi.cpp
index 90acdb6..3055f6b 100644
--- a/tesseract4android/src/main/cpp/tesseract/tessbaseapi.cpp
+++ b/tesseract4android/src/main/cpp/tesseract/tessbaseapi.cpp
@@ -193,6 +193,59 @@ jboolean Java_com_googlecode_tesseract_android_TessBaseAPI_nativeInitOem(JNIEnv
   return res;
 }
 
+jboolean Java_com_googlecode_tesseract_android_TessBaseAPI_nativeInitMemory(JNIEnv *env,
+                                                                           jobject thiz,
+                                                                           jlong mNativeData,
+                                                                           jbyteArray modelData,
+                                                                           jstring lang,
+                                                                           jint mode) {
+  native_data_t *nat = (native_data_t*) mNativeData;
+  if (!nat) {
+    LOGE("native_data_t pointer is null");
+    return JNI_FALSE;
+  }
+  if (!modelData) {
+    LOGE("modelData array is null");
+    return JNI_FALSE;
+  }
+  jsize size = env->GetArrayLength(modelData);
+  if (size <= 0) {
+    LOGE("modelData array length is <= 0");
+    return JNI_FALSE;
+  }
+  if (mode < 0 || mode > 3) {
+    LOGE("Invalid OCR engine mode: %d", mode);
+    return JNI_FALSE;
+  }
+  const char *c_lang = lang ? env->GetStringUTFChars(lang, NULL) : NULL;
+  if (lang && !c_lang) {
+    LOGE("Failed to extract language string");
+    return JNI_FALSE;
+  }
+  const char *lang_str = c_lang ? c_lang : "eng";
+
+  jbyte *bytes = env->GetByteArrayElements(modelData, NULL);
+  if (!bytes) {
+    LOGE("Failed to pin modelData byte array");
+    if (lang && c_lang) env->ReleaseStringUTFChars(lang, c_lang);
+    return JNI_FALSE;
+  }
+
+  jboolean res = JNI_TRUE;
+  if (nat->api.Init((const char*) bytes, (int) size, lang_str, (tesseract::OcrEngineMode) mode,
+                    nullptr, 0, nullptr, nullptr, false, nullptr)) {
+    LOGE("Could not initialize Tesseract API from memory buffer with language=%s!", lang_str);
+    res = JNI_FALSE;
+  } else {
+    LOGI("Initialized Tesseract API from memory buffer with language=%s", lang_str);
+  }
+
+  if (lang && c_lang) env->ReleaseStringUTFChars(lang, c_lang);
+  env->ReleaseByteArrayElements(modelData, bytes, JNI_ABORT);
+
+  return res;
+}
