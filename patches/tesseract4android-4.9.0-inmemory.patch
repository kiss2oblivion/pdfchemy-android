+	/**
+	 * Initializes the Tesseract engine directly from an in-memory traineddata model byte array.
+	 * Returns <code>true</code> on success.
+	 *
+	 * @param modelData     the raw bytes of the traineddata model file
+	 * @param language      an ISO 639-3 string representing the language(s)
+	 * @param ocrEngineMode the OCR engine mode to be set
+	 * @return <code>true</code> on success
+	 */
+	public boolean init(byte[] modelData, String language, @OcrEngineMode int ocrEngineMode) {
+		if (mRecycled) {
+			throw new IllegalStateException();
+		}
+		if (modelData == null || modelData.length == 0) {
+			throw new IllegalArgumentException("modelData must not be empty");
+		}
+		if (language == null) {
+			throw new IllegalArgumentException("language must not be null");
+		}
+		return nativeInitMemory(mNativeData, modelData, language, ocrEngineMode);
+	}
+
+	/**
+	 * Initializes the Tesseract engine directly from an in-memory traineddata model byte array
+	 * with default engine mode {@link #OEM_DEFAULT}. Returns <code>true</code> on success.
+	 *
+	 * @param modelData the raw bytes of the traineddata model file
+	 * @param language  an ISO 639-3 string representing the language(s)
+	 * @return <code>true</code> on success
+	 */
+	public boolean init(byte[] modelData, String language) {
+		return init(modelData, language, OEM_DEFAULT);
+	}
